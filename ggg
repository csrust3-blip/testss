    ----------------------------------------------------------
    -- PROCESS HATCHED PET
    ----------------------------------------------------------

    local function updateRarestPet(PetInfo, PetData)
        if type(PetInfo) ~= "table" or not PetInfo.Name then
            return
        end

        local Success, Name, Rarity, Chance = pcall(function()
            return
                ItemUtil:GetName(PetInfo),
                ItemUtil:GetRarity(PetInfo),
                PetUtil:GetChance(PetInfo)
        end)

        if not Success or not Name or not Rarity then
            warn(
                "[LegendUI] Failed to read hatched pet:",
                tostring(PetInfo.Name),
                tostring(Name)
            )
            return
        end

        local RankSuccess, Rank = pcall(function()
            return rarityLevel(Rarity)
        end)

        Rank = RankSuccess and tonumber(Rank) or 0

        if PetInfo.Super and Rank == 1 then
            Rank = 2
        end

        local NumericChance = getComparableChance(Chance)
        local IsRarer = Rank > RarestPetRank

        if Rank == RarestPetRank and NumericChance then
            local PreviousChance =
                getComparableChance(RarestPetChance)

            if not PreviousChance
                or NumericChance > PreviousChance then
                IsRarer = true
            end
        end

        if not RarestPetName then
            IsRarer = true
        end

        if not IsRarer then
            return
        end

        RarestPetRank = Rank
        RarestPetName = tostring(Name)
        RarestPetRarity = tostring(Rarity)
        RarestPetChance = Chance
        RarestPetAsset = nil
        RarestPetExist = findExistCount(PetData) or findExistCount(PetInfo)

        local Variants = {}

        if PetInfo.Super then
            table.insert(Variants, "Super")
        end

        if PetInfo.Mythic then
            table.insert(Variants, "Mythic")
        end

        if PetInfo.Shiny then
            table.insert(Variants, "Shiny")
        end

        RarestPetVariant = table.concat(Variants, " ")

        ------------------------------------------------------
        -- SELECT PET IMAGE
        ------------------------------------------------------

        local PetDefinition = Pets[PetInfo.Name]

        if PetDefinition and PetDefinition.Images then
            local Images = PetDefinition.Images
            local Image

            if PetInfo.Mythic and PetInfo.Shiny then
                Image = Images.MythicShiny
            elseif PetInfo.Mythic then
                Image = Images.Mythic
            elseif PetInfo.Shiny then
                Image = Images.Shiny
            end

            Image = Image
                or Images.Normal
                or Images.Shiny
                or Images.Mythic
                or Images.MythicShiny

            RarestPetAsset = Image
        else
            warn(
                "[LegendUI] Pet image definition not found:",
                tostring(PetInfo.Name)
            )
        end

        print(
            "[LegendUI] Rarest pet updated:",
            RarestPetName,
            "Rarity:",
            RarestPetRarity,
            "Chance:",
            tostring(Chance),
            "Chance type:",
            typeof(Chance)
        )

        refreshRarestPetSection()
    end

    ----------------------------------------------------------
    -- HATCH EVENT LISTENER
    ----------------------------------------------------------

    local ListenerSuccess, Listener = pcall(function()
        return RemoteModule.Event("HatchEgg"):Connect(
            function(Data)
                if type(Data) ~= "table"
                    or type(Data.Pets) ~= "table" then
                    return
                end

                LastHatchData = Data

                for _, PetData in pairs(Data.Pets) do
                    if type(PetData) == "table" then
                        if type(PetData.Pet) == "table" then
                            updateRarestPet(PetData.Pet, PetData)
                        elseif PetData.Name then
                            updateRarestPet(PetData, PetData)
                        end
                    end
                end
            end
        )
    end)

    if ListenerSuccess then
        RarestPetConnection = Listener
    else
        warn(
            "[LegendUI] Rarest pet listener failed:",
            tostring(Listener)
        )
    end

    ----------------------------------------------------------
    -- PLAYER LEADERSTATS
    ----------------------------------------------------------

    local function refreshPlayerStats()
        local Leaderstats =
            LocalPlayer:FindFirstChild("leaderstats")

        local Seen = {}

        if Leaderstats then
            for _, Stat in ipairs(Leaderstats:GetChildren()) do
                if Stat:IsA("IntValue")
                    or Stat:IsA("NumberValue")
                    or Stat:IsA("StringValue") then

                    Seen[Stat.Name] = true

                    local Label = PlayerLabels[Stat.Name]

                    if not Label then
                        Label = addReadout(
                            PlayerStatsBox,
                            Stat.Name
                        )

                        PlayerLabels[Stat.Name] = Label
                    end

                    setReadout(
                        Label,
                        Stat.Name .. ": "
                            .. formatStatValue(
                                Stat.Name,
                                Stat.Value
                            )
                    )
                end
            end
        end

        for Name, Label in pairs(PlayerLabels) do
            if not Seen[Name] then
                setReadout(
                    Label,
                    Name .. ": (unavailable)"
                )
            end
        end
    end

    ----------------------------------------------------------
    -- SESSION STATISTICS
    ----------------------------------------------------------

    local SessionReadouts = {
        {
            "Script session uptime",
            function()
                return formatDuration(
                    os.clock()
                        - (
                            Env.HatchStatsSessionStartedAt
                            or os.clock()
                        )
                )
            end
        },
        {
            "Server elapsed time",
            function()
                return formatDuration(
                    workspace.DistributedGameTime
                )
            end
        },
        {
            "Pets hatched since execution",
            function()
                return tostring(
                    Env.HatchStatsPetsHatched or 0
                )
            end
        },
        {
            "Successful hatch webhook posts",
            function()
                return tostring(
                    Env.HatchStatsWebhookPosts or 0
                )
            end
        },
        {
            "Webhook notifications enabled",
            function()
                return tostring(
                    Env.HatchWebhookEnabled or false
                )
            end
        },
    }

    for Index, Entry in ipairs(SessionReadouts) do
        SessionLabels[Index] = addReadout(
            SessionStatsBox,
            Entry[1]
        )
    end

    ----------------------------------------------------------
    -- LIVE UPDATE LOOP
    ----------------------------------------------------------

    task.spawn(function()
        while true do
            refreshPlayerStats()

            for Index, Entry in ipairs(SessionReadouts) do
                local Ok, Value = pcall(Entry[2])

                if Ok then
                    setReadout(
                        SessionLabels[Index],
                        Entry[1] .. ": " .. tostring(Value)
                    )
                else
                    setReadout(
                        SessionLabels[Index],
                        Entry[1] .. ": unavailable"
                    )
                end
            end

            task.wait(1)
        end
    end)

    ----------------------------------------------------------
    -- ABBREVIATION TOGGLE
    ----------------------------------------------------------

    addToggle(
        PlayerStatsBox,
        "Abbreviate Eggs & Bubbles",
        true,
        function(Value)
            AbbreviateCurrencies = Value
            refreshPlayerStats()
        end
    )

    ----------------------------------------------------------
    -- CLEANUP
    ----------------------------------------------------------

    onCleanup(function()
        if RarestPetConnection then
            pcall(function()
                RarestPetConnection:Disconnect()
            end)

            RarestPetConnection = nil
        end

        RarestPetImageRequest += 1

        if RarestPetRow then
            pcall(function()
                RarestPetRow:Destroy()
            end)

            RarestPetRow = nil
        end
    end)
