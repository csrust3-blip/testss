do
    local RenderedIndex = 15
    local RenderedTp = false
    local RenderedTpRunning = false

    local function getRenderedTarget()
        local Rendered = workspace:FindFirstChild("Rendered")
        return Rendered and Rendered:GetChildren()[RenderedIndex]
    end

    CollectablesBox:AddButton("Print Rendered children", function()
        runDebugButton(function()
            local Rendered = workspace:FindFirstChild("Rendered")

            if not Rendered then
                debugWarn("RenderedCollectables", "workspace.Rendered not found")
                return
            end

            for Index, Child in ipairs(Rendered:GetChildren()) do
                debugPrint(
                    "RenderedCollectables",
                    Index,
                    Child.Name,
                    Child.ClassName,
                    Index == RenderedIndex and "<-- target" or ""
                )
            end
        end)
    end)

    local function setRenderedTp(Value)
        RenderedTp = Value

        if not RenderedTp or RenderedTpRunning then
            return
        end

        RenderedTpRunning = true

        task.spawn(function()
            local WarnedEmpty = false

            while RenderedTp do
                local Target = getRenderedTarget()
                local Children = Target and Target:GetChildren() or {}

                if #Children == 0 then
                    if not WarnedEmpty then
                        debugWarn(
                            "RenderedCollectables",
                            "Rendered TP: nothing found in workspace.Rendered:GetChildren()[" .. RenderedIndex .. "]"
                        )
                        WarnedEmpty = true
                    end
                else
                    WarnedEmpty = false
                end

                for _, Child in ipairs(Children) do
                    if not RenderedTp then
                        break
                    end

                    if Child.Parent then
                        local TargetCFrame = getObjectCFrame(Child)
                        local Character = LocalPlayer.Character

                        if TargetCFrame and Character then
                            Character:PivotTo(TargetCFrame + Vector3.new(0, 3, 0))
                            task.wait()
                        end
                    end
                end

                task.wait(0.1)
            end

            RenderedTpRunning = false
        end)
    end

    local RenderedToggle = addToggle(
        CollectablesBox,
        "TP through Rendered children",
        false,
        setRenderedTp
    )

    Features.RenderedTp = {
        Toggle = RenderedToggle,
        SetEnabled = setRenderedTp,
        IsEnabled = function()
            return RenderedTp
        end,
    }

    onCleanup(function()
        RenderedTp = false
    end)
end

