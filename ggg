    end

    ----------------------------------------------------------
    -- ODDS HELPERS
    ----------------------------------------------------------

    local function formatOddsDenominator(Number)
        Number = tonumber(Number)

        if not Number or Number <= 0 then
            return nil
        end

        return FormatSuffix(math.ceil(Number))
    end

    local function getOddsDenominator(Chance, Depth)
        Depth = Depth or 0

        if Chance == nil or Depth > 3 then
            return nil
        end

        if type(Chance) == "table" then
            local PossibleKeys = {
                "Odds",
                "Chance",
                "Denominator",
                "Value",
                "OneIn",
                "OneInChance",
            }

            for _, Key in ipairs(PossibleKeys) do
                if Chance[Key] ~= nil then
                    local Result = getOddsDenominator(
                        Chance[Key],
                        Depth + 1
                    )

                    if Result then
                        return Result
                    end
                end
            end

            return nil
        end

        local ChanceText = tostring(Chance)

        local FractionDenominator =
            ChanceText:match("^%s*1%s*/%s*([%d%.]+)%s*$")

        if FractionDenominator then
            return formatOddsDenominator(FractionDenominator)
        end

        local OneInDenominator =
            string.lower(ChanceText):match("1%s*in%s*([%d%.]+)")

        if OneInDenominator then
            return formatOddsDenominator(OneInDenominator)
        end

        local Percentage =
            ChanceText:match("^%s*([%d%.]+)%s*%%%s*$")

        if Percentage then
            local PercentageNumber = tonumber(Percentage)

            if PercentageNumber and PercentageNumber > 0 then
                return formatOddsDenominator(
                    100 / PercentageNumber
                )
            end

            return nil
        end

        local NumericChance = tonumber(Chance)

        if not NumericChance or NumericChance <= 0 then
            return nil
        end

        -- Assumes a numeric result is a percentage, matching
        -- the original code's calculation.
        return formatOddsDenominator(100 / NumericChance)
    end

    local function getComparableChance(Chance)
        if type(Chance) == "table" then
            local PossibleKeys = {
                "Odds",
                "Chance",
                "Denominator",
                "Value",
                "OneIn",
                "OneInChance",
            }

            for _, Key in ipairs(PossibleKeys) do
                if Chance[Key] ~= nil then
                    local Result = getComparableChance(Chance[Key])

                    if Result then
                        return Result
                    end
                end
            end

            return nil
        end

        local Text = tostring(Chance or "")

        local Fraction =
            Text:match("^%s*1%s*/%s*([%d%.]+)%s*$")

        if Fraction then
            return tonumber(Fraction)
        end

        local OneIn =
            string.lower(Text):match("1%s*in%s*([%d%.]+)")

        if OneIn then
            return tonumber(OneIn)
        end

        local Percentage =
            Text:match("^%s*([%d%.]+)%s*%%%s*$")

        if Percentage then
            local Value = tonumber(Percentage)

            if Value and Value > 0 then
                return 100 / Value
            end

            return nil
        end

        local Numeric = tonumber(Chance)

        if Numeric and Numeric > 0 then
            return 100 / Numeric
        end

        return nil
    end

    ----------------------------------------------------------
    -- IMAGE SOURCE RESOLVER
    ----------------------------------------------------------

    local function resolvePetImage(ImageValue, Depth)
        Depth = Depth or 0

        if ImageValue == nil or Depth > 4 then
            return nil
        end

        local ValueType = typeof(ImageValue)

        if ValueType == "table" then
            local PossibleKeys = {
                "Image",
                "ImageId",
                "ImageID",
                "AssetId",
                "AssetID",
                "Id",
                "ID",
                "id",
                "Normal",
                "Thumbnail",
                "Icon",
                "IconImage",
            }

            for _, Key in ipairs(PossibleKeys) do
                local ChildValue = ImageValue[Key]

                if ChildValue ~= nil then
                    local Result = resolvePetImage(
                        ChildValue,
                        Depth + 1
                    )

                    if Result then
                        return Result
                    end
                end
            end

            return nil
        end

        if ValueType ~= "string" and ValueType ~= "number" then
            return nil
        end

        local TextValue = tostring(ImageValue)

        if TextValue == "" then
            return nil
        end

        if TextValue:match("^rbxassetid://")
            or TextValue:match("^rbxthumb://")
            or TextValue:match("^https?://") then
            return TextValue
        end

        local NumericID = tonumber(TextValue)

        if NumericID then
            local ThumbnailOK, Thumbnail = pcall(
                getThumbnail,
                NumericID
            )

            if ThumbnailOK
                and Thumbnail ~= nil
                and tostring(Thumbnail) ~= "" then

                local ThumbnailText = tostring(Thumbnail)

                if tonumber(ThumbnailText) then
                    return "rbxassetid://" .. ThumbnailText
                end

                return ThumbnailText
            end

            return "rbxassetid://" .. tostring(
                math.floor(NumericID)
            )
        end

        local ThumbnailOK, Thumbnail = pcall(
            getThumbnail,
            ImageValue
        )

        if ThumbnailOK
            and Thumbnail ~= nil
            and tostring(Thumbnail) ~= "" then
            return tostring(Thumbnail)
        end

        return nil
    end

