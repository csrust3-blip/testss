    local function removeLeadingVariant(Name, Variant)
        if not Name or not Variant then
            return Name
        end

        local EscapedVariant = Variant:gsub(
            "([^%w])",
            "%%%1"
        )

        return Name:gsub(
            "^%s*" .. EscapedVariant .. "%s+",
            "",
            1
        )
    end

    local function cleanPetName(Name)
        Name = tostring(Name or "")

        -- Strip leading variant words so they aren't duplicated.
        -- Repeat because names can contain several prefixes.
        for _ = 1, 4 do
            local Before = Name

            Name = removeLeadingVariant(Name, "Super")
            Name = removeLeadingVariant(Name, "Mythic")
            Name = removeLeadingVariant(Name, "Shiny")

            if Name == Before then
                break
            end
        end

        return Name
    end

    local function findExistCount(Value, Depth)
        Depth = Depth or 0

        if type(Value) ~= "table" or Depth > 3 then
            return nil
        end

        for Key, Child in pairs(Value) do
            if type(Key) == "string"
                and Key:lower():find("exist", 1, true)
                and tonumber(Child) then
                return tonumber(Child)
            end
        end

        for _, Child in pairs(Value) do
            if type(Child) == "table" then
                local Result = findExistCount(Child, Depth + 1)
                if Result then
                    return Result
                end
            end
        end

        return nil
    end

    local function dumpTable(Value, Indent, Depth)
        Indent = Indent or ""
        Depth = Depth or 0
        if Depth > 4 then return end

        for Key, Child in pairs(Value) do
            print(Indent .. tostring(Key) .. " = " .. tostring(Child) .. " (" .. typeof(Child) .. ")")
            if type(Child) == "table" then
                dumpTable(Child, Indent .. "  ", Depth + 1)
            end
        end
    end

