----------------------------------------------------------
-- 5.4c RIFT TELEPORT
----------------------------------------------------------
-- Rifts live in workspace.Rendered.Rifts. Each rift has a child called
-- "Display" (plus Decoration / Gift / Sign / Output); we teleport to Display.

do
    local RiftBox = FarmLeft:AddBox("Rift Teleport")

    local CHECK_RATE = 0.25
    local OPEN_DELAY = 0.1
    local HATCH_AMOUNT = 12
    local SelectedEgg = ""

    local DetectorEnabled = false
    local DetectorSession = 0
    local DetectorConnections = {}
    local CurrentEgg = nil

    local HatchEnabled = false
    local HatchSession = 0

    local function getEggFolder()
        local Rendered = workspace:FindFirstChild("Rendered")
        return Rendered and Rendered:FindFirstChild("Generic")
    end

    local function findClosestEgg()
        local Folder = getEggFolder()
        local Root = getRoot()

        if not Folder or not Root then
            return nil
        end

        local Closest, ClosestDist = nil, math.huge

        for _, Child in ipairs(Folder:GetChildren()) do
            if Child.Name:find("Egg", 1, true) then
                local Ok, Pivot = pcall(function()
                    return Child:GetPivot()
                end)

                if Ok then
                    local Dist = (Pivot.Position - Root.Position).Magnitude

                    if Dist < ClosestDist then
                        Closest, ClosestDist = Child, Dist
                    end
                end
            end
        end

        return Closest, ClosestDist
    end

    local function onNewClosest(Egg, Dist)
        if Egg then
            SelectedEgg = Egg.Name
            debugPrint("Eggs", ("New closest egg: %s (%.1f studs)"):format(Egg.Name, Dist))
        else
            debugPrint("Eggs", "No eggs nearby")
        end
    end

    local function checkClosest()
        local Egg, Dist = findClosestEgg()

        if Egg ~= CurrentEgg then
            CurrentEgg = Egg
            onNewClosest(Egg, Dist)
        end
    end

    local function disconnectDetector()
        for _, Connection in ipairs(DetectorConnections) do
            Connection:Disconnect()
        end

        table.clear(DetectorConnections)
        CurrentEgg = nil
    end

    local function startDetector()
        disconnectDetector()

        local Folder = getEggFolder()

        if not Folder then
            debugWarn("Eggs", "Egg detector: workspace.Rendered.Generic not found")
            return
        end

        DetectorSession += 1
        local Session = DetectorSession

        table.insert(DetectorConnections, Folder.ChildAdded:Connect(function()
            if DetectorEnabled and Session == DetectorSession then
                task.defer(checkClosest)
            end
        end))

        table.insert(DetectorConnections, Folder.ChildRemoved:Connect(function()
            if DetectorEnabled and Session == DetectorSession then
                task.defer(checkClosest)
            end
        end))

        task.spawn(function()
            while DetectorEnabled and Session == DetectorSession do
                checkClosest()
                task.wait(CHECK_RATE)
            end
        end)
    end

    local function openEgg(EggName)
        RemoteEvent:FireServer("HatchEgg", EggName, HATCH_AMOUNT)
    end

    local function startHatch()
        HatchSession += 1
        local Session = HatchSession

        task.spawn(function()
            while HatchEnabled and Session == HatchSession do
                if SelectedEgg ~= "" then
                    local Ok, Err = pcall(openEgg, SelectedEgg)

                    if not Ok then
                        debugWarn("Eggs", "openEgg failed:", Err)
                    end
                end

                task.wait(OPEN_DELAY)
            end
        end)
    end

    addToggle(RiftBox, "Closest egg detector", false, function(Value)
        DetectorEnabled = Value

        if Value then
            startDetector()
        else
            DetectorSession += 1
            disconnectDetector()
        end
    end)

    local function setAutoHatch(Value)
        HatchEnabled = Value

        if Value then
            startHatch()
        else
            HatchSession += 1
        end
    end

    local HatchToggle = addToggle(RiftBox, "Auto Hatch", false, setAutoHatch)

    Features.AutoHatch = {
        Toggle = HatchToggle,
        SetEnabled = setAutoHatch,
        IsEnabled = function()
            return HatchEnabled
        end,
    }

    registerShopFarmManagedFeature("Auto Hatch", HatchToggle, function()
        return HatchEnabled
    end)

    onCleanup(function()
        DetectorEnabled = false
        DetectorSession += 1
        disconnectDetector()
        HatchEnabled = false
        HatchSession += 1
    end)


    -- Names as they appear in workspace.Rendered.Rifts. Matching ignores case,
    -- hyphens, spaces and underscores, so "cyber-egg" also matches "CyberEgg".
    -- Use "Print rift names" to see what is currently spawned and add more here.
    local RiftOptions = {
        "atlantis-egg",
        "classic-egg",
        "crystal-egg",
        "cyber-egg",
        "gift-rift",
        "golden-chest",
        "hell-egg",
        "iceshard-egg",
        "icy-egg",
        "inferno-egg",
        "lava-egg",
        "lunar-egg",
        "magma-egg",
        "mining-egg",
        "neon-egg",
        "nightmare-egg",
        "rainbow-egg",
        "shadow-rift",
        "showman-egg",
        "spikey-egg",
        "spotted-egg",
        "vine-egg",
        "void-egg",
    }

    local SelectedRift = "gift-rift"

    local TARGET_PART_NAME = "Display"  -- child of each rift to teleport to
    local TP_HEIGHT = 3                 -- studs above the Display (slider below)
    local CHECK_INTERVAL = 0.25         -- how often the watcher runs
    local RETURN_DELAY = 1              -- seconds with no rift before returning (covers brief respawns)
    local MAX_DRIFT = 15                -- re-teleport if knocked this far from the Display

    local RiftEnabled = false
    local RiftSession = 0
    local OriginalPivot = nil

    local function normalizeRiftName(Name)
        return (tostring(Name):lower():gsub("[^%w]", ""))
    end

    local function getRiftFolder()
        local Rendered = workspace:FindFirstChild("Rendered")
        return Rendered and Rendered:FindFirstChild("Rifts")
    end

    -- The part we actually teleport to: the rift's Display, or the rift itself
    -- if it has no Display.
    local function getRiftTarget(Rift)
        return Rift:FindFirstChild(TARGET_PART_NAME, true) or Rift
    end

    local function FindRifts()
        local Rifts = {}
        local Folder = getRiftFolder()

        if not Folder then
            return Rifts
        end

        local Wanted = normalizeRiftName(SelectedRift)

        for _, Rift in ipairs(Folder:GetChildren()) do
            if normalizeRiftName(Rift.Name) == Wanted then
                table.insert(Rifts, Rift)
            end
        end

        return Rifts
    end

    local function getClosestRift(Rifts)
        local Root = getRoot()
        local Closest, ClosestDist = nil, math.huge

        for _, Rift in ipairs(Rifts) do
            local TargetCFrame = getObjectCFrame(getRiftTarget(Rift))

            if TargetCFrame then
                local Dist = Root and (TargetCFrame.Position - Root.Position).Magnitude or 0

                if Dist < ClosestDist then
                    Closest, ClosestDist = Rift, Dist
                end
            end
        end

        return Closest
    end

    local function tptorift(Rift)
        local Character = LocalPlayer.Character
        local TargetCFrame = Rift and getObjectCFrame(getRiftTarget(Rift))

        if not Character or not TargetCFrame then
            return false
        end

        -- Only remember the starting spot once per trip
        if not OriginalPivot then
            OriginalPivot = Character:GetPivot()
            debugPrint("Misc", "[Rift] Saved original position")
        end

        local Root = getRoot()
        if Root then
            Root.AssemblyLinearVelocity = Vector3.zero
        end

        Character:PivotTo(TargetCFrame + Vector3.new(0, TP_HEIGHT, 0))
        return true
    end

    local function returnToOrigin()
        if not OriginalPivot then
            return
        end

        local Character = LocalPlayer.Character

        if Character then
            local Root = getRoot()
            if Root then
                Root.AssemblyLinearVelocity = Vector3.zero
            end

            pcall(function()
                Character:PivotTo(OriginalPivot)
            end)

            debugPrint("Misc", "[Rift] Returned to the starting position")
        end

        OriginalPivot = nil
    end

    local function startWatcher()
        RiftSession += 1
        local Session = RiftSession

        task.spawn(function()
            local Current = nil
            local GoneSince = nil

            while RiftEnabled and Session == RiftSession do
                -- The rift disappeared (destroyed or removed from workspace)
                if Current and not Current:IsDescendantOf(workspace) then
                    debugPrint("Misc", "[Rift] Rift disappeared")
                    Current = nil
                end

                if not Current then
                    local Rift = getClosestRift(FindRifts())

                    if Rift then
                        if tptorift(Rift) then
                            Current = Rift
                            GoneSince = nil
                            debugPrint("Misc", "[Rift] Teleported to", Rift.Name)
                        end
                    elseif OriginalPivot then
                        -- No rift left: wait a moment in case another spawns, then go back
                        GoneSince = GoneSince or os.clock()

                        if os.clock() - GoneSince >= RETURN_DELAY then
                            returnToOrigin()
                            GoneSince = nil
                        end
                    end
                else
                    -- Stay on the Display if something pushed us away
                    local Root = getRoot()
                    local TargetCFrame = getObjectCFrame(getRiftTarget(Current))

                    if Root and TargetCFrame
                        and (Root.Position - TargetCFrame.Position).Magnitude > MAX_DRIFT then
                        tptorift(Current)
                    end
                end

                task.wait(CHECK_INTERVAL)
            end
        end)
    end

    RiftBox:AddDropdown("Rift to teleport to", RiftOptions, SelectedRift, function(Value)
        SelectedRift = Value
    end)

    RiftBox:AddSlider("Height above Display", 0, 20, TP_HEIGHT, function(Value)
        TP_HEIGHT = Value
    end)

    addToggle(RiftBox, "Auto TP to rift", false, function(Value)
        RiftEnabled = Value

        if Value then
            startWatcher()
        else
            RiftSession += 1
            returnToOrigin()
        end
    end)

    RiftBox:AddButton("Print rift names", function()
        runDebugButton(function()
            local Folder = getRiftFolder()

            if not Folder then
                debugWarn("Misc", "workspace.Rendered.Rifts not found")
                return
            end

            local Children = Folder:GetChildren()

            if #Children == 0 then
                debugPrint("Misc", "No rifts are currently spawned")
                return
            end

            for Index, Rift in ipairs(Children) do
                debugPrint("Misc", Index, Rift.Name, Rift.ClassName)
            end
        end)
    end)

    RiftBox:AddButton("Diagnose rift teleport", function()
        runDebugButton(function()
            print("[Rift] Toggle enabled:", RiftEnabled)
            print("[Rift] Selected rift:", SelectedRift)
            print("[Rift] Saved original position:", OriginalPivot ~= nil)

            local Folder = getRiftFolder()

            if not Folder then
                warn("[Rift] workspace.Rendered.Rifts NOT FOUND")
                return
            end

            local Children = Folder:GetChildren()
            print("[Rift] Children in Rifts folder:", #Children)

            for Index, Rift in ipairs(Children) do
                local Matches = normalizeRiftName(Rift.Name) == normalizeRiftName(SelectedRift)
                local Display = Rift:FindFirstChild(TARGET_PART_NAME, true)

                print(
                    "[Rift]", Index,
                    "name='" .. Rift.Name .. "'",
                    Rift.ClassName,
                    "matches:", Matches,
                    "Display found:", Display ~= nil,
                    Display and Display.ClassName or "",
                    "has position:", getObjectCFrame(getRiftTarget(Rift)) ~= nil
                )
            end

            print("[Rift] Matching rifts found:", #FindRifts())
        end)
    end)

    onCleanup(function()
        RiftEnabled = false
        RiftSession += 1
        returnToOrigin()
    end)
end

----------------------------------------------------------
-- 5.4d PRESENT RAIN
----------------------------------------------------------

do
    local TP_HEIGHT = 3          -- studs above each item
    local CHECK_INTERVAL = 0.25  -- how often the watcher looks for items
    local RETURN_DELAY = 1       -- seconds with nothing left before returning
    local ItemWait = 0.1         -- seconds spent on each item

    local PresentEnabled = false
    local PresentSession = 0
    local OriginalPivot = nil
    local PresentToggle

    local function getPresentFolder()
        local Rendered = workspace:FindFirstChild("Rendered")
        return Rendered and Rendered:FindFirstChild("PresentRain")
    end

    local function returnToOrigin()
        if not OriginalPivot then
            return
        end

        local Character = LocalPlayer.Character

        if Character then
            local Root = getRoot()
            if Root then
                Root.AssemblyLinearVelocity = Vector3.zero
            end

            pcall(function()
                Character:PivotTo(OriginalPivot)
            end)

            debugPrint("Misc", "[Present Rain] Returned to the starting position")
        end

        OriginalPivot = nil
    end

    local function tpToItem(Item)
        local Character = LocalPlayer.Character
        local TargetCFrame = Item and getObjectCFrame(Item)

        if not Character or not TargetCFrame then
            return false
        end

        -- Only remember the starting spot once per trip
        if not OriginalPivot then
            OriginalPivot = Character:GetPivot()
            debugPrint("Misc", "[Present Rain] Saved original position")
        end

        local Root = getRoot()
        if Root then
            Root.AssemblyLinearVelocity = Vector3.zero
        end

        Character:PivotTo(TargetCFrame + Vector3.new(0, TP_HEIGHT, 0))
        return true
    end

    local function startWatcher()
        PresentSession += 1
        local Session = PresentSession

        task.spawn(function()
            local GoneSince = nil

            while PresentEnabled and Session == PresentSession do
                local Folder = getPresentFolder()
                local Items = Folder and Folder:GetChildren() or {}

                if #Items > 0 then
                    GoneSince = nil

                    for _, Item in ipairs(Items) do
                        if not PresentEnabled or Session ~= PresentSession then
                            break
                        end

                        -- Items can vanish while we're still working through the list
                        if Item.Parent and tpToItem(Item) then
                            task.wait(ItemWait)
                        end
                    end
                else
                    -- Nothing left: wait a moment in case more drop, then go back
                    if OriginalPivot then
                        GoneSince = GoneSince or os.clock()

                        if os.clock() - GoneSince >= RETURN_DELAY then
                            returnToOrigin()
                            GoneSince = nil
                        end
                    end
                end

                task.wait(CHECK_INTERVAL)
            end
        end)
    end

    GiftBox:AddSlider("Wait per item (x0.1s)", 0, 10, ItemWait * 10, function(Value)
        ItemWait = Value / 10
    end)

    PresentToggle = addToggle(GiftBox, "Auto TP to presents", false, function(Value)
        PresentEnabled = Value

        if Value then
            startWatcher()
        else
            PresentSession += 1
            returnToOrigin()
        end
    end)

    -- Shop Farm turns this off while it farms, then turns it back on afterwards
    registerShopFarmManagedFeature("Present Rain TP", PresentToggle, function()
        return PresentEnabled
    end)

    GiftBox:AddButton("Print present rain children", function()
        runDebugButton(function()
            local Folder = getPresentFolder()

            if not Folder then
                debugWarn("Misc", "workspace.Rendered.PresentRain not found")
                return
            end

            local Children = Folder:GetChildren()

            if #Children == 0 then
                debugPrint("Misc", "PresentRain is empty")
                return
            end

            for Index, Item in ipairs(Children) do
                debugPrint("Misc", Index, Item.Name, Item.ClassName)
            end
        end)
    end)

    onCleanup(function()
        PresentEnabled = false
        PresentSession += 1
        returnToOrigin()
    end)
end

