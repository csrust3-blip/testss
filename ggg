local function getRoot()
    local Character = LocalPlayer.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function getObjectCFrame(Object)
    if Object:IsA("Model") then
        return Object:GetPivot()
    elseif Object:IsA("BasePart") then
        return Object.CFrame
    end

    local Part = Object:FindFirstChildWhichIsA("BasePart", true)
    return Part and Part.CFrame
end

local Features = {}
local ShopFarmManagedFeatures = {}

local function registerShopFarmManagedFeature(Name, Toggle, IsEnabled)
    table.insert(ShopFarmManagedFeatures, {
        Name = Name,
        Toggle = Toggle,
        IsEnabled = IsEnabled,
    })
end

local function setManagedToggle(Toggle, Value)
    if not Toggle then return end

    if type(Toggle.Set) == "function" then
        local Ok = pcall(Toggle.Set, Toggle, Value)
        if Ok then return end
    end

    if type(Toggle.set) == "function" then
        pcall(Toggle.set, Toggle, Value)
    end
end

local function suspendShopFarmManagedFeatures()
    local SavedStates = {}

    for _, Feature in ipairs(ShopFarmManagedFeatures) do
        local Ok, WasEnabled = pcall(Feature.IsEnabled)

        if Ok and WasEnabled then
            SavedStates[Feature.Name] = true
            setManagedToggle(Feature.Toggle, false)
            debugPrint("ShopFarm", "[Shop Farm] Temporarily disabled:", Feature.Name)
        end
    end

    return SavedStates
end

local function restoreShopFarmManagedFeatures(SavedStates)
    for _, Feature in ipairs(ShopFarmManagedFeatures) do
        if SavedStates and SavedStates[Feature.Name] then
            setManagedToggle(Feature.Toggle, true)
            debugPrint("ShopFarm", "[Shop Farm] Re-enabled:", Feature.Name)
        end
    end
end

local PriceSuffixes = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
    QA = 1e15,
    QI = 1e18,
}

local function parsePrice(Text)
    local Clean = tostring(Text):gsub(",", ""):gsub("%s", "")
    local Num, Suf = Clean:match("^([%d%.]+)(%a*)$")
    Num = tonumber(Num)

    if not Num then
        return nil
    end

    return Num * (PriceSuffixes[Suf:upper()] or 1)
end

local function formatNumber(Number)
    local Units = {
        {1e18, "Qi"},
        {1e15, "Qa"},
        {1e12, "T"},
        {1e9, "B"},
        {1e6, "M"},
        {1e3, "K"},
    }

    for _, Unit in ipairs(Units) do
        if Number >= Unit[1] then
            return string.format("%.2f%s", Number / Unit[1], Unit[2])
        end
    end

    return string.format("%d", Number)
end

local function getPath(Root, ...)
    local Current = Root

    for _, Name in ipairs({...}) do
        Current = Current and Current:FindFirstChild(Name)
    end

    return Current
end

local function isValidURL(URL)
    return type(URL) == "string"
        and URL ~= ""
        and not URL:find("PASTE_NEW")
end

local function sendWebhook(URL, Payload)
    local Requester = (syn and syn.request)
        or (http and http.request)
        or http_request
        or request

    if not Requester then
        debugWarn("GeneralWarnings", "Webhook failed: executor has no request function")
        return false
    end

    local Success, Response = pcall(Requester, {
        Url = URL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(Payload)
    })

    if not Success then
        debugWarn("GeneralWarnings", "Webhook request errored:", Response)
        return false
    end

    local Code = Response and (Response.StatusCode or Response.Status)

    if Code and Code >= 200 and Code < 300 then
        debugPrint("HatchWebhook", "Webhook sent successfully!")
        return true
    end

    debugWarn("GeneralWarnings", "Webhook rejected by Discord. Status:", Code, Response and Response.Body)
    return false
end

