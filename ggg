do
    local Waypoints = {}
    local WaypointMarkers = {}
    local Moving = false
    local CurrentWaypoint = 1
    local MoveSpeed = 16
    local WaitEnabled = false
    local WaitTime = 5
    local WaitUntil = 0
    local ArrivalDistance = 3
    local ShowWaypoints = true
    local MovementConnection

    local function setWaypointVisibility(IsVisible)
        ShowWaypoints = IsVisible

        for _, Marker in ipairs(WaypointMarkers) do
            if Marker and Marker.Parent then
                Marker.Transparency = IsVisible and 0.15 or 1

                local Label = Marker:FindFirstChild("WaypointLabel", true)
                if Label then
                    Label.Enabled = IsVisible
                end
            end
        end
    end

    local function createWaypointMarker(Position, Number)
        local Marker = Instance.new("Part")
        Marker.Name = "Waypoint_" .. Number
        Marker.Shape = Enum.PartType.Ball
        Marker.Size = Vector3.new(1.5, 1.5, 1.5)
        Marker.Position = Position + Vector3.new(0, 1.5, 0)
        Marker.Anchored = true
        Marker.CanCollide = false
        Marker.CanTouch = false
        Marker.CanQuery = false
        Marker.Material = Enum.Material.Neon
        Marker.Color = Color3.fromRGB(236, 32, 160)
        Marker.Transparency = ShowWaypoints and 0.15 or 1
        Marker.Parent = workspace

        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = "WaypointLabel"
        Billboard.Size = UDim2.fromOffset(100, 35)
        Billboard.StudsOffset = Vector3.new(0, 1.5, 0)
        Billboard.AlwaysOnTop = true
        Billboard.Enabled = ShowWaypoints
        Billboard.Parent = Marker

        local Text = Instance.new("TextLabel")
        Text.Size = UDim2.fromScale(1, 1)
        Text.BackgroundTransparency = 1
        Text.Text = "Waypoint " .. Number
        Text.TextColor3 = Color3.fromRGB(255, 255, 255)
        Text.TextStrokeTransparency = 0
        Text.TextScaled = true
        Text.Font = Enum.Font.SourceSansBold
        Text.Parent = Billboard

        table.insert(WaypointMarkers, Marker)
    end

    local function clearWaypointMarkers()
        for _, Marker in ipairs(WaypointMarkers) do
            if Marker then
                Marker:Destroy()
            end
        end

        table.clear(WaypointMarkers)
    end

    local function stopMovement()
        Moving = false
        CurrentWaypoint = 1
        WaitUntil = 0

        if MovementConnection then
            MovementConnection:Disconnect()
            MovementConnection = nil
        end

        local Root = getRoot()

        if Root then
            local CurrentVelocity = Root.AssemblyLinearVelocity
            Root.AssemblyLinearVelocity = Vector3.new(0, CurrentVelocity.Y, 0)
        end

        debugPrint("Waypoints", "Waypoint movement stopped")
    end

    local function walkWaypoints()
        if #Waypoints == 0 then
            debugWarn("Waypoints", "No waypoints have been set")
            return
        end

        stopMovement()
        Moving = true
        CurrentWaypoint = 1

        MovementConnection = RunService.Heartbeat:Connect(function()
            if not Moving then
                return
            end

            local Root = getRoot()

            if not Root then
                stopMovement()
                return
            end

            if os.clock() < WaitUntil then
                local CurrentVelocity = Root.AssemblyLinearVelocity
                Root.AssemblyLinearVelocity = Vector3.new(0, CurrentVelocity.Y, 0)
                return
            end

            local Target = Waypoints[CurrentWaypoint]

            if not Target then
                CurrentWaypoint = 1
                Target = Waypoints[CurrentWaypoint]
            end

            local TargetPosition = Vector3.new(Target.X, Root.Position.Y, Target.Z)
            local Offset = TargetPosition - Root.Position
            local Distance = Offset.Magnitude

            if Distance <= ArrivalDistance then
                CurrentWaypoint += 1

                if CurrentWaypoint > #Waypoints then
                    CurrentWaypoint = 1
                    debugPrint("Waypoints", "Returned to waypoint 1, looping again")
                end

                if WaitEnabled then
                    WaitUntil = os.clock() + WaitTime
                    debugPrint("Waypoints", "Waiting", WaitTime, "seconds at waypoint")
                end

                return
            end

            local Direction = Offset.Unit
            local CurrentVelocity = Root.AssemblyLinearVelocity

            Root.AssemblyLinearVelocity = Vector3.new(
                Direction.X * MoveSpeed,
                CurrentVelocity.Y,
                Direction.Z * MoveSpeed
            )
        end)

        debugPrint("Waypoints", "Waypoint loop started")
    end

    WaypointSettingsBox:AddSlider("Movement speed", 1, 20, MoveSpeed, function(Value)
        MoveSpeed = Value
    end)

    addToggle(WaypointSettingsBox, "Wait at each waypoint", false, function(Value)
        WaitEnabled = Value
    end)

    WaypointSettingsBox:AddSlider("Wait time (seconds)", 1, 60, WaitTime, function(Value)
        WaitTime = Value
    end)

    addToggle(WaypointSettingsBox, "Show waypoint visuals", false, function(Value)
        setWaypointVisibility(Value)
    end)

    addToggle(WaypointSettingsBox, "Walk waypoints", false, function(Value)
        if Value then
            walkWaypoints()
        else
            stopMovement()
        end
    end)

    WaypointBox:AddButton("Set waypoint here", function()
        local Root = getRoot()

        if not Root then
            debugWarn("Waypoints", "Character root not found")
            return
        end

        table.insert(Waypoints, Root.Position)
        createWaypointMarker(Root.Position, #Waypoints)

        debugPrint("Waypoints", "Waypoint", #Waypoints, "set at", tostring(Root.Position))
    end)

    WaypointBox:AddButton("Create Circle Waypoints", function()
        local Root = getRoot()

        if not Root then
            debugWarn("Waypoints", "Character root not found")
            return
        end

        local Radius = 30
        local WaypointCount = 12
        local Center = Root.Position

        for i = 1, WaypointCount do
            local Angle = ((i - 1) / WaypointCount) * math.pi * 2
            local Position = Center + Vector3.new(
                math.cos(Angle) * Radius,
                0,
                math.sin(Angle) * Radius
            )

            table.insert(Waypoints, Position)
            createWaypointMarker(Position, #Waypoints)
        end

        debugPrint("Waypoints", "Created", WaypointCount, "circle waypoints with radius", Radius)
    end)

    WaypointBox:AddButton("Clear waypoints", function()
        stopMovement()
        table.clear(Waypoints)
        clearWaypointMarkers()
        debugPrint("Waypoints", "All waypoints cleared")
    end)

    onCleanup(function()
        stopMovement()
        clearWaypointMarkers()
    end)
end

