        AutoUseGifts = false
        ClaimKeyConnection:Disconnect()
    end)
end

----------------------------------------------------------
-- 5.6 HATCH WEBHOOK
----------------------------------------------------------

do
    local RarityOrder = {
        Legendary = 1,
        SuperLegendary = 2,
        Secret = 3,
        Infinity = 4
    }

    local function rarityLevel(Name)
        return RarityOrder[(tostring(Name):gsub("%s+", ""))] or 0
    end

    local SelectedWebhook = "Evolve"
    local SelectedRarity = "Super Legendary"
    local WebhookEnabled = false
    local WebhookConnection
    -- Session counters reset whenever this script is executed.
    Env.HatchStatsSessionStartedAt = os.clock()
    Env.HatchStatsWebhookPosts = 0
    Env.HatchStatsPetsHatched = 0

    local function getThumbnail(Image)
        local ImageURL

        pcall(function()
            local AssetId = tostring(Image):match("%d+")

            if AssetId then
                local ThumbnailData = HttpService:JSONDecode(
                    game:HttpGet(
                        "https://thumbnails.roblox.com/v1/assets?assetIds="
                        .. AssetId
                        .. "&size=420x420&format=Png"
                    )
                )

                if ThumbnailData.data and ThumbnailData.data[1] then
                    ImageURL = ThumbnailData.data[1].imageUrl
                end
            end
        end)

        return ImageURL
    end

    local function handleHatch(Data)
        if not WebhookEnabled or not Data or not Data.Pets then
            return
        end

        Env.HatchStatsPetsHatched = (Env.HatchStatsPetsHatched or 0) + #Data.Pets

        local DataInfo = LocalData:Get()
        local Embeds = {}
        local MinimumLevel = rarityLevel(SelectedRarity)

        for _, PetData in Data.Pets do
            local Rarity = ItemUtil:GetRarity(PetData.Pet)
            local PetRarityLevel = rarityLevel(Rarity)
            local Name = ItemUtil:GetName(PetData.Pet)
            local Chance = PetUtil:GetChance(PetData.Pet)
            local IsSuper = PetData.Pet.Super and true or false
            local EffectiveLevel = PetRarityLevel

            if IsSuper and EffectiveLevel == 1 then
                EffectiveLevel = 2
            end

            if EffectiveLevel >= MinimumLevel then
                local Pet = Pets[PetData.Pet.Name]

                if Pet then
                    local Stats = {}

                    for StatName, StatValue in PetUtil:GetStats(PetData.Pet) do
                        Stats[#Stats + 1] = "> " .. StatName .. ": " .. FormatCommas(math.floor(StatValue))
                    end

                    local Image = Pet.Images.Normal

                    if PetData.Pet.Mythic then
                        Image = PetData.Pet.Shiny and Pet.Images.MythicShiny or Pet.Images.Mythic
                    elseif PetData.Pet.Shiny then
                        Image = Pet.Images.Shiny
                    end

                    local Embed = {
                        title = ((IsSuper and not tostring(Name):lower():find("^super")) and "Super " or "")
                            .. Name .. " Pet Hatched (Odds 1/" .. FormatSuffix(math.ceil(100 / Chance)) .. ")",
                        description = "Total Hatches: **" .. FormatCommas(DataInfo.Stats.Hatches)
                            .. "**\nRarity: **" .. tostring(Rarity) .. "**\n"
                            .. table.concat(Stats, "\n"),
                        color = 0xFF0000
                    }

                    local ImageURL = getThumbnail(Image)

                    if ImageURL then
                        Embed.thumbnail = {url = ImageURL}
                    end

                    table.insert(Embeds, Embed)
                end
            end
        end

        if #Embeds == 0 then
            return
        end

        local URL = Config.Webhooks[SelectedWebhook]
        local Role = Config.RoleIds[SelectedWebhook]

        if not isValidURL(URL) then
            debugWarn("HatchWebhook", "No valid webhook URL set for", SelectedWebhook)
            return
        end

        local Payload = {
            content = (Role and Role ~= "") and ("<@&" .. Role .. ">") or "",
            embeds = Embeds
        }

        if Role and Role ~= "" then
            Payload.allowed_mentions = {roles = {Role}}
        end

        if sendWebhook(URL, Payload) then
            Env.HatchStatsWebhookPosts = (Env.HatchStatsWebhookPosts or 0) + 1
        end
    end

    WebhookBox:AddDropdown("Select Webhook", Config.WebhookNames, "Evolve", function(Value)
        SelectedWebhook = Value
    end)

    WebhookBox:AddDropdown(
        "Minimum Rarity",
        {"Super Legendary", "Secret", "Infinity"},
        "Super Legendary",
        function(Value)
            SelectedRarity = Value
        end
    )

    addToggle(WebhookBox, "Enable Webhook Notifications", false, function(Value)
        WebhookEnabled = Value
        Env.HatchWebhookEnabled = Value

        if WebhookEnabled and not WebhookConnection then
            WebhookConnection = RemoteModule.Event("HatchEgg"):Connect(function(Data)
                task.spawn(handleHatch, Data)
            end)
        end
    end)

    WebhookBox:AddButton("Send Test Webhook", function()
        local URL = Config.Webhooks[SelectedWebhook]

        if not isValidURL(URL) then
            debugWarn("HatchWebhook", "No valid webhook URL set for", SelectedWebhook)
            return
        end

        sendWebhook(URL, {
            content = "",
            embeds = {{
                title = "Webhook test",
                description = "If you can see this, the webhook works.",
                color = 0x00FF00
            }}
        })
    end)

    onCleanup(function()
        WebhookEnabled = false

        if WebhookConnection then
            WebhookConnection:Disconnect()
            WebhookConnection = nil
        end
    end)
end

----------------------------------------------------------
-- 5.7 AUTO ENCHANT
----------------------------------------------------------
-- The game's UseShadowCrystal call takes ONE lock slot (a number) or nil, so only
-- one enchant can be protected at a time.
--
-- "Auto Enchant" toggle:
--     Rerolls even if the pet already has the goal. Keeps (locks) an enchant that is
--     already there and rolls the other slot.
-- "Reroll (ignore current enchants)" button:
--     Treats whatever is on the pet as worthless. The first roll has NO lock, so
--     everything is rerolled. After each roll, the first goal enchant that lands gets
--     locked and it keeps going for the other.
-- Both finish by re-reading the pet and confirming it really has the goal enchants.

do
    local AutoEnchantEnabled = false
    local AutoEnchantRunning = false
    local EnchantDryRun = true
    local EnchantGoal = "Both (Shiny Seeker first)"
    local EnchantMaxTries = 30
    local EnchantDelay = 0.3
    local EnchantWaitTimeout = 3
    local EnchantStaleLimit = 4      -- stop after this many rolls in a row that changed nothing
    local EnchantLockEither = true   -- also lock Ultra Roller if it lands before Shiny Seeker

    local function enchantNormalize(Value)
        return (tostring(Value):lower():gsub("[%s_%-]+", ""))
    end

    local function enchantContains(Value, Target, Seen)
        if type(Value) == "string" then
            return enchantNormalize(Value):find(enchantNormalize(Target), 1, true) ~= nil
        end
        if type(Value) ~= "table" then return false end
        Seen = Seen or {}
        if Seen[Value] then return false end
        Seen[Value] = true
        for Key, Child in pairs(Value) do
            if type(Key) == "string"
                and enchantNormalize(Key):find(enchantNormalize(Target), 1, true) then
                return true
            end
            if enchantContains(Child, Target, Seen) then return true end
        end
        return false
    end

    local function getEnchantSlot(Enchants, TargetName)
        if type(Enchants) ~= "table" then return nil end
        for Slot = 1, 6 do
            if Enchants[Slot] ~= nil and enchantContains(Enchants[Slot], TargetName, {}) then
                return Slot
            end
        end
        return nil
    end

    local function getEnchantPetById(Id)
        local Ok, Data = pcall(function() return LocalData:Get() end)
        if not Ok or type(Data) ~= "table" or type(Data.Pets) ~= "table" then return nil end
        for _, Pet in pairs(Data.Pets) do
            if type(Pet) == "table" and Pet.Id == Id then return Pet end
        end
        return nil
    end

    local function getEnchantEquippedIds()
        local Ok, Data = pcall(function() return LocalData:Get() end)
        if not Ok or type(Data) ~= "table" or type(Data.Pets) ~= "table" then return {} end

        local KnownIds = {}
        for _, Pet in pairs(Data.Pets) do
            if type(Pet) == "table" and Pet.Id ~= nil then
                KnownIds[tostring(Pet.Id)] = Pet.Id
            end
        end

        local Team = Data.Teams and Data.Teams[Data.TeamEquipped]
        if type(Team) ~= "table" then
            debugWarn("AutoEnchant", "[Auto Enchant] Equipped team data was not found.")
            return {}
        end

        local Found, Added = {}, {}
        local function Walk(Value, Visited)
            if type(Value) ~= "table" or Visited[Value] then return end
            Visited[Value] = true
            for Key, Child in pairs(Value) do
                local IdKey = type(Child) == "string" and Child or tostring(Child)
                local Match = KnownIds[IdKey]
                if Match ~= nil and (type(Child) == "string" or type(Child) == "number") then
                    if not Added[IdKey] then
                        Added[IdKey] = true
                        Found[#Found + 1] = Match
                    end
                elseif type(Key) == "string" and KnownIds[Key] ~= nil then
                    if not Added[Key] then
                        Added[Key] = true
                        Found[#Found + 1] = KnownIds[Key]
                    end
                elseif type(Child) == "table" then
                    Walk(Child, Visited)
                end
            end
        end
        Walk(Team, {})
        return Found
    end

    local function enchantSnapshot(Value, Seen)
        if type(Value) ~= "table" then return tostring(Value) end
        Seen = Seen or {}
        if Seen[Value] then return "<cycle>" end
        Seen[Value] = true
        local Parts = {}
        for Key, Child in pairs(Value) do
            Parts[#Parts + 1] = tostring(Key) .. "=" .. enchantSnapshot(Child, Seen)
        end
        table.sort(Parts)
        Seen[Value] = nil
        return "{" .. table.concat(Parts, ",") .. "}"
    end

    local function waitForEnchantChange(Id, Before)
        local Started = os.clock()
        while os.clock() - Started < EnchantWaitTimeout do
            local Pet = getEnchantPetById(Id)
            if Pet and enchantSnapshot(Pet.Enchants) ~= Before then return true end
            task.wait(0.1)
        end
        return false
    end

    -- Which goal enchants does this Enchants table have, and in which slots?
    local function checkEnchantGoal(Enchants)
        local Names = {"Shiny Seeker"}
        if EnchantGoal ~= "Shiny Seeker Only" then
            Names[2] = "Ultra Roller"
        end

        local Found, AllPresent = {}, true
        for _, Name in ipairs(Names) do
            local Slot = getEnchantSlot(Enchants, Name)
            Found[Name] = Slot
            if not Slot then AllPresent = false end
        end
        return Found, AllPresent, Names
    end

    -- Which single enchant should be locked? Shiny Seeker first.
    local function pickEnchantLock(Found, Names)
        for _, Name in ipairs(Names) do
            if Found[Name] and (Name == "Shiny Seeker" or EnchantLockEither) then
                return Name, Found[Name]
            end
        end
        return nil, nil
    end

    -- Re-read the pet a moment later and confirm it really has the goal enchants
    local function verifyEnchantGoal(Id)
        task.wait(0.5)
        local Pet = getEnchantPetById(Id)
        local _, AllPresent = checkEnchantGoal(Pet and Pet.Enchants)

        if AllPresent then
            debugPrint("AutoEnchant", "[Auto Enchant] VERIFIED:", enchantSnapshot(Pet.Enchants))
        else
            debugWarn("AutoEnchant", "[Auto Enchant] NOT verified: the pet no longer has the goal enchants.")
        end
        return AllPresent
    end

    -- Returns "stop" if the whole pass should stop, otherwise nil
    local function processEnchantPet(Id, Index, Total, Force, IgnoreCurrent)
        local Pet = getEnchantPetById(Id)
        if not Pet then
            debugWarn("AutoEnchant", ("[Auto Enchant] Pet %d/%d not found; skipped."):format(Index, Total))
            return
        end

        debugPrint("AutoEnchant", ("[Auto Enchant] Pet %d/%d: %s"):format(Index, Total, tostring(Pet.Name or Id)))
        debugPrint("AutoEnchant", "[Auto Enchant] Starting enchants:", enchantSnapshot(Pet.Enchants))

        local LockedName, LockedSlot = nil, nil
        local StaleCount = 0

        for Attempt = 1, EnchantMaxTries do
            if not AutoEnchantEnabled then return "stop" end

            Pet = getEnchantPetById(Id)
            if not Pet then
                debugWarn("AutoEnchant", "[Auto Enchant] Pet disappeared; stopping.")
                return "stop"
            end

            local Found, AllPresent, Names = checkEnchantGoal(Pet.Enchants)
            local FirstRoll = Force and Attempt == 1

            -- Already has everything: done, unless this is a forced first roll
            if AllPresent and not FirstRoll then
                debugPrint("AutoEnchant", "[Auto Enchant] Goal reached.")
                if not verifyEnchantGoal(Id) then return "stop" end
                return
            end

            -- Ignore-current mode: the first roll has no lock, so nothing is protected
            if IgnoreCurrent and FirstRoll then
                debugPrint("AutoEnchant", "[Auto Enchant] Ignoring current enchants: first roll has no lock.")
            elseif not LockedName then
                local Name, Slot = pickEnchantLock(Found, Names)
                if Name then
                    LockedName, LockedSlot = Name, Slot
                    debugPrint("AutoEnchant", ("[Auto Enchant] Locking %s in slot %d."):format(Name, Slot))
                end
            end

            if EnchantDryRun then
                debugPrint("AutoEnchant", ("[Auto Enchant] DRY RUN %d/%d: would reroll with lock slot %s"):format(
                    Attempt, EnchantMaxTries, tostring(LockedSlot)
                ))
                return
            end

            local Before = enchantSnapshot(Pet.Enchants)

            local Ok, Err = pcall(function()
                RemoteEvent:FireServer("UseShadowCrystal", Id, LockedSlot)
            end)
            if not Ok then
                debugWarn("AutoEnchant", "[Auto Enchant] Reroll call failed:", Err)
                return "stop"
            end

            local Changed = waitForEnchantChange(Id, Before)

            Pet = getEnchantPetById(Id)
            if not Pet then
                debugWarn("AutoEnchant", "[Auto Enchant] Pet data disappeared after reroll.")
                return "stop"
            end

            debugPrint("AutoEnchant", ("[Auto Enchant] Roll %d: %s"):format(Attempt, enchantSnapshot(Pet.Enchants)))

            -- Same result is a normal outcome. Only a long run of identical
            -- results suggests the crystals ran out.
            if Changed then
                StaleCount = 0
            else
                StaleCount += 1
                debugPrint("AutoEnchant", ("[Auto Enchant] Same result as before (%d/%d)."):format(StaleCount, EnchantStaleLimit))
            end

            local NewFound, NewAllPresent = checkEnchantGoal(Pet.Enchants)

            -- The locked enchant must still be exactly where we locked it
            if LockedName and Changed and NewFound[LockedName] ~= LockedSlot then
                debugWarn("AutoEnchant", "[Auto Enchant] LOCK CHECK FAILED: " .. LockedName
                    .. " is no longer in slot " .. LockedSlot .. ". Stopping.")
                return "stop"
            end

            if NewAllPresent then
                debugPrint("AutoEnchant", "[Auto Enchant] Goal reached for this pet.")
                if not verifyEnchantGoal(Id) then return "stop" end
                return
            end

            if StaleCount >= EnchantStaleLimit then
                debugWarn("AutoEnchant", "[Auto Enchant] Too many identical results in a row (out of crystals?). Stopping.")
                return "stop"
            end

            task.wait(EnchantDelay)
        end

        debugWarn("AutoEnchant", "[Auto Enchant] Maximum rerolls reached for pet", tostring(Id))
    end

    local function runEnchantPass(Force, IgnoreCurrent)
        if AutoEnchantRunning then return end
        AutoEnchantRunning = true
        task.spawn(function()
            local Ok, Err = pcall(function()
                local Ids = getEnchantEquippedIds()
                if #Ids == 0 then
                    debugWarn("AutoEnchant", "[Auto Enchant] No equipped pets found; check the LocalData team structure.")
                    return
                end
                debugPrint("AutoEnchant", ("[Auto Enchant] Starting pass over %d equipped pet(s)."):format(#Ids))
                for Index, Id in ipairs(Ids) do
                    if not AutoEnchantEnabled then break end
                    if processEnchantPet(Id, Index, #Ids, Force, IgnoreCurrent) == "stop" then
                        break
                    end
                    task.wait(0.1)
                end
                debugPrint("AutoEnchant", "[Auto Enchant] Pass finished.")
            end)
            if not Ok then debugWarn("AutoEnchant", "[Auto Enchant] Error:", Err) end
            AutoEnchantRunning = false
        end)
    end

    EnchantBox:AddDropdown(
        "Enchant goal",
        {"Both (Shiny Seeker first)", "Shiny Seeker only"},
        "Both (Shiny Seeker first)",
        function(Value) EnchantGoal = Value end
    )

    EnchantBox:AddSlider("Max rerolls per pet", 1, 100, EnchantMaxTries, function(Value)
        EnchantMaxTries = Value
    end)

    EnchantBox:AddSlider("Delay (x0.1s)", 1, 50, 3, function(Value)
        EnchantDelay = Value / 10
    end)

    addToggle(EnchantBox, "Lock Ultra Roller if it lands first", true, function(Value)
        EnchantLockEither = Value
    end)

    addToggle(EnchantBox, "Dry run (no rerolls)", true, function(Value)
        EnchantDryRun = Value
    end)

    addToggle(EnchantBox, "Auto Enchant", false, function(Value)
        AutoEnchantEnabled = Value
        if Value then runEnchantPass(true, false) end
    end)

    EnchantBox:AddButton("Reroll (ignore current enchants)", function()
        if AutoEnchantRunning then
            debugWarn("AutoEnchant", "[Auto Enchant] A pass is already running.")
            return
        end
        local WasEnabled = AutoEnchantEnabled
        AutoEnchantEnabled = true
        runEnchantPass(true, true)
        task.spawn(function()
            while AutoEnchantRunning do task.wait(0.1) end
            if not WasEnabled then AutoEnchantEnabled = false end
        end)
    end)

    onCleanup(function()
        AutoEnchantEnabled = false
    end)
end

----------------------------------------------------------
-- 5.8 STATUS UPDATES + CLOSE ALERT
----------------------------------------------------------

do
    local StatusEnabled = false
    local StatusSession = 0
    local StatusInterval = 5 -- minutes
    local StatusStart = os.time()
    local LastHatches = 0
    local ClosedSent = false
    local StatusConnections = {}

    local function formatUptime(Seconds)
        return string.format("%dh %02dm %02ds",
            math.floor(Seconds / 3600),
            math.floor(Seconds % 3600 / 60),
            Seconds % 60
        )
    end

    local function getHatches()
        local Success, Data = pcall(function()
            return LocalData:Get()
        end)

        return (Success and Data and Data.Stats and Data.Stats.Hatches) or 0
    end

    local function sendStatus(Title, Description, Color, Ping)
        if not isValidURL(Config.StatusWebhook) then
            debugWarn("StatusUpdates", "No valid status webhook URL set")
            return false
        end

        local RoleId = Config.StatusRoleId
        local ShouldPing = Ping and RoleId ~= ""

        local Payload = {
            content = ShouldPing and ("<@&" .. RoleId .. ">") or "",
            embeds = {{
                title = Title,
                description = Description,
                color = Color,
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        }

        if ShouldPing then
            Payload.allowed_mentions = {roles = {RoleId}}
        end

        return sendWebhook(Config.StatusWebhook, Payload)
    end

    local function sendClosed(Reason)
        if not StatusEnabled or ClosedSent then
            return
        end

        ClosedSent = true

        sendStatus(
            "Game closed / disconnected",
            "Player: **" .. LocalPlayer.Name .. "**"
                .. "\nReason: " .. tostring(Reason)
                .. "\nUptime: **" .. formatUptime(os.time() - StatusStart) .. "**"
                .. "\nTotal Hatches: **" .. FormatCommas(getHatches()) .. "**",
            0xFF0000,
            true
        )
    end

    local function disconnectStatus()
        for _, Connection in ipairs(StatusConnections) do
            pcall(function()
                Connection:Disconnect()
            end)
        end

        table.clear(StatusConnections)
    end

    local function startStatus()
        StatusSession += 1
        local Session = StatusSession

        StatusStart = os.time()
        LastHatches = getHatches()
        ClosedSent = false

        -- Close / disconnect detection
        table.insert(StatusConnections,
            game:GetService("GuiService").ErrorMessageChanged:Connect(function(Message)
                if Message and Message ~= "" then
                    sendClosed("Error message: " .. Message)
                end
            end)
        )

        pcall(function()
            table.insert(StatusConnections,
                game:GetService("NetworkClient").ChildRemoved:Connect(function()
                    sendClosed("Lost connection to the server")
                end)
            )
        end)

        table.insert(StatusConnections,
            Players.PlayerRemoving:Connect(function(Player)
                if Player == LocalPlayer then
                    sendClosed("Player left the game")
                end
            end)
        )

        -- Periodic updates
        task.spawn(function()
            sendStatus(
                "Status monitoring started",
                "Player: **" .. LocalPlayer.Name .. "**\nUpdates every **" .. StatusInterval .. "** min.",
                0x00FF00,
                false
            )

            while StatusEnabled and Session == StatusSession do
                local Interval = StatusInterval * 60
                local Waited = 0

                -- wait in 1s steps so toggling off / changing interval reacts quickly
                while Waited < Interval and StatusEnabled and Session == StatusSession do
                    task.wait(1)
                    Waited += 1
                end

                if not StatusEnabled or Session ~= StatusSession then
                    break
                end

                local Hatches = getHatches()

                sendStatus(
                    "Status update",
                    "Player: **" .. LocalPlayer.Name .. "**"
                        .. "\nUptime: **" .. formatUptime(os.time() - StatusStart) .. "**"
                        .. "\nTotal Hatches: **" .. FormatCommas(Hatches) .. "**"
                        .. "\nHatches since last update: **" .. FormatCommas(Hatches - LastHatches) .. "**"
                        .. "\nNext update: <t:" .. (os.time() + StatusInterval * 60) .. ":R>",
                    0x3498DB,
                    false
                )

                LastHatches = Hatches
            end
        end)
    end

    WebhookBox:AddSlider("Update interval (min)", 1, 60, StatusInterval, function(Value)
        StatusInterval = Value
    end)

    addToggle(WebhookBox, "Status updates + close alert", false, function(Value)
        StatusEnabled = Value

        if Value then
            startStatus()
        else
            StatusSession += 1
            disconnectStatus()
        end
    end)

    onCleanup(function()
        StatusEnabled = false
        StatusSession += 1
        disconnectStatus()
    end)
end

