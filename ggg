    local function equipTeam(TeamNumber)
        TeamNumber = tonumber(TeamNumber)

        if not TeamNumber or TeamNumber < 1 or TeamNumber > 13 then
            debugWarn("ShopFarm", "[Shop Farm] Invalid team number:", TeamNumber)
            return
        end

        local Success, Err = pcall(function()
            RemoteEvent:FireServer("EquipTeam", TeamNumber)
        end)

        if not Success then
            debugWarn("ShopFarm", "[Shop Farm] Failed to equip team:", Err)
        else
            debugPrint("ShopFarm", "[Shop Farm] Requested team:", TeamNumber)
        end
    end

    local function getPlayerGui()
        return LocalPlayer:FindFirstChild("PlayerGui")
    end

    local function setFeature(Feature, Value)
        if not Feature then
            return
        end

        Feature.SetEnabled(Value)

        if Feature.Toggle and Feature.Toggle.Set then
            pcall(Feature.Toggle.Set, Feature.Toggle, Value)
        end
    end

    local function readShop()
        local ScrollingFrame = getPath(
            getPlayerGui(),
            "ScreenGui",
            "ItemShop",
            "Frame",
            "Main",
            "ScrollingFrame"
        )

        if not ScrollingFrame then
            return nil
        end

        local Shop = {
            Count = 0,
            InStock = 0,
            Total = 0,
            Unreadable = 0,
        }

        for _, Item in ipairs(ScrollingFrame:GetChildren()) do
            if Item.Name:match("^Item%d+$") then
                local StockLabel = Item:FindFirstChild("Stock")

                if StockLabel then
                    Shop.Count += 1

                    if not StockLabel.Text:lower():find(OUT_OF_STOCK_TEXT, 1, true) then
                        Shop.InStock += 1

                        local PriceLabel = getPath(
                            Item,
                            "Buttons",
                            "BuyAll",
                            "Button",
                            "Frame",
                            "Label"
                        )

                        local Price = PriceLabel and parsePrice(PriceLabel.Text)

                        if Price then
                            Shop.Total += Price
                        else
                            Shop.Unreadable += 1
                        end
                    end
                end
            end
        end

        return Shop
    end

    local function readCurrency()
        local Label = getPath(
            getPlayerGui(),
            "ScreenGui",
            "HUD",
            "Left",
            "Currency",
            CURRENCY_NAME,
            "Frame",
            "Label"
        )

        return Label and parsePrice(Label.Text)
    end

    local function describePath(Root, ...)
        local Current = Root
        local Walked = {}

        for _, Name in ipairs({...}) do
            local Next = Current and Current:FindFirstChild(Name)

            if not Next then
                return false, table.concat(Walked, ".") .. " -> missing '" .. Name .. "'"
            end

            Current = Next
            table.insert(Walked, Name)
        end

        return true, Current
    end

    local function explainMissing()
        local Parts = {}

        local ShopOk, ShopInfo = describePath(
            getPlayerGui(),
            "ScreenGui",
            "ItemShop",
            "Frame",
            "Main",
            "ScrollingFrame"
        )

        if not ShopOk then
            table.insert(Parts, "shop path broke at: " .. ShopInfo)
        end

        local CurOk, CurInfo = describePath(
            getPlayerGui(),
            "ScreenGui",
            "HUD",
            "Left",
            "Currency",
            CURRENCY_NAME,
            "Frame",
            "Label"
        )

        if not CurOk then
            table.insert(Parts, "currency path broke at: " .. CurInfo)
        end

        if #Parts == 0 then
            table.insert(
                Parts,
                "paths exist, but no item has a Stock label or the currency text isn't readable"
            )
        end

        return table.concat(Parts, " | ")
    end

    local function printShopStatus()
        debugPrint("ShopFarm", "[Shop Farm] ---------- status ----------")

        local ScrollingFrame = getPath(
            getPlayerGui(),
            "ScreenGui",
            "ItemShop",
            "Frame",
            "Main",
            "ScrollingFrame"
        )

        if not ScrollingFrame then
            debugWarn("ShopFarm", "[Shop Farm] " .. explainMissing())
        else
            local Items = {}

            for _, Item in ipairs(ScrollingFrame:GetChildren()) do
                if Item.Name:match("^Item%d+$") then
                    table.insert(Items, Item)
                end
            end

            table.sort(Items, function(a, b)
                return tonumber(a.Name:match("%d+")) < tonumber(b.Name:match("%d+"))
            end)

            for _, Item in ipairs(Items) do
                local Stock = Item:FindFirstChild("Stock")
                local Price = getPath(Item, "Buttons", "BuyAll", "Button", "Frame", "Label")

                debugPrint(
                    "ShopFarm",
                    ("%s | Stock: %s | BuyAll price: %s"):format(
                        Item.Name,
                        Stock and ("'" .. Stock.Text .. "'") or "NO Stock label",
                        Price and ("'" .. Price.Text .. "'") or "NO price label"
                    )
                )
            end
        end

        local CurLabel = getPath(
            getPlayerGui(),
            "ScreenGui",
            "HUD",
            "Left",
            "Currency",
            CURRENCY_NAME,
            "Frame",
            "Label"
        )

        debugPrint(
            "ShopFarm",
            "[Shop Farm] Currency label:",
            CurLabel and ("'" .. CurLabel.Text .. "'") or "NOT FOUND"
        )

        local Shop = readShop()
        local Currency = readCurrency()

        if Shop then
            debugPrint(
                "ShopFarm",
                ("[Shop Farm] Parsed: %d/%d in stock, total needed %s, currency %s"):format(
                    Shop.InStock,
                    Shop.Count,
                    formatNumber(Shop.Total),
                    Currency and formatNumber(Currency) or "unreadable"
                )
            )
        end
    end

    local function startFarming()
        if Farming then
            return
        end

        Farming = true

        local Character = LocalPlayer.Character
        OriginalPlayerPivot = Character and Character:GetPivot() or nil

        SuspendedFeatureStates = suspendShopFarmManagedFeatures()
        setFeature(Features.AutoHatch, false)

        task.wait(0.2)
        if not Farming then return end

        equipTeam(FarmingTeam)

        task.wait(0.2)
        if not Farming then return end

        setFeature(Features.RenderedTp, true)

        debugPrint("ShopFarm", "[Shop Farm] Farming started with team:", FarmingTeam)
    end

    local function stopFarming()
        if not Farming then
            return
        end

        Farming = false
        setFeature(Features.RenderedTp, false)

        task.wait(0.2)
        equipTeam(RestoreTeam)

        task.wait(0.2)

        local Character = LocalPlayer.Character

        if Character and OriginalPlayerPivot then
            pcall(function()
                Character:PivotTo(OriginalPlayerPivot)
            end)

            debugPrint("ShopFarm", "[Shop Farm] Returned to the starting position")
        end

        OriginalPlayerPivot = nil

        local StatesToRestore = SuspendedFeatureStates
        SuspendedFeatureStates = nil

        restoreShopFarmManagedFeatures(StatesToRestore)

        debugPrint("ShopFarm", "[Shop Farm] Restored team:", RestoreTeam)
    end

    local function finish(Reason)
        debugPrint("ShopFarm", "[Shop Farm] Done: " .. Reason)
        stopFarming()

        if DISABLE_TOGGLE_WHEN_DONE then
            ShopEnabled = false
            ShopSession += 1

            if ShopToggle and ShopToggle.Set then
                pcall(ShopToggle.Set, ShopToggle, false)
            end
        end
    end

    local function startWatcher()
        ShopSession += 1
        local Session = ShopSession

        task.spawn(function()
            local WarnedMissing = false
            local NotifiedEnough = false
            local LastProgress = 0
            local LastStatus = 0

            while ShopEnabled and Session == ShopSession do
                local Shop = readShop()
                local Currency = readCurrency()

                if not Shop or Shop.Count == 0 or not Currency then
                    if not WarnedMissing then
                        debugWarn(
                            "ShopFarm",
                            "[Shop Farm] Can't read the shop/currency: " .. explainMissing()
                        )
                        WarnedMissing = true
                    end
                else
                    WarnedMissing = false

                    local Target = Shop.Total + EXTRA_BUFFER

                    if Shop.Unreadable > 0 then
                        debugWarn(
                            "ShopFarm",
                            ("[Shop Farm] Couldn't read the price of %d item(s); they aren't counted"):format(
                                Shop.Unreadable
                            )
                        )
                    end

                    if not Farming then
                        local Stocked = (START_WHEN == "all" and Shop.InStock == Shop.Count)
                            or (START_WHEN == "any" and Shop.InStock > 0)

                        if not Stocked then
                            NotifiedEnough = false

                            if os.clock() - LastStatus >= STATUS_INTERVAL then
                                LastStatus = os.clock()

                                debugPrint(
                                    "ShopFarm",
                                    ("[Shop Farm] Waiting: %d/%d items in stock (need %s), currency %s"):format(
                                        Shop.InStock,
                                        Shop.Count,
                                        START_WHEN == "all" and "all of them" or "at least 1",
                                        formatNumber(Currency)
                                    )
                                )
                            end
                        elseif Currency >= Target then
                            if not NotifiedEnough then
                                NotifiedEnough = true

                                debugPrint(
                                    "ShopFarm",
                                    ("[Shop Farm] Shop is stocked and you already have enough (%s / %s)"):format(
                                        formatNumber(Currency),
                                        formatNumber(Target)
                                    )
                                )
                            end
                        else
                            NotifiedEnough = false

                            debugPrint(
                                "ShopFarm",
                                ("[Shop Farm] Shop stocked, farming %s / %s"):format(
                                    formatNumber(Currency),
                                    formatNumber(Target)
                                )
                            )

                            startFarming()
                            LastProgress = os.clock()
                        end
                    else
                        if Shop.InStock == 0 then
                            finish("everything is out of stock")
                        elseif Currency >= Target then
                            finish(
                                ("enough currency (%s / %s)"):format(
                                    formatNumber(Currency),
                                    formatNumber(Target)
                                )
                            )
                        elseif os.clock() - LastProgress >= 10 then
                            LastProgress = os.clock()

                            debugPrint(
                                "ShopFarm",
                                ("[Shop Farm] Farming %s / %s"):format(
                                    formatNumber(Currency),
                                    formatNumber(Target)
                                )
                            )
                        end
                    end
                end

                task.wait(CHECK_INTERVAL)
            end
        end)
    end

    ShopBox:AddSlider("Extra buffer (billions)", 0, 50, EXTRA_BUFFER / 1e9, function(Value)
        EXTRA_BUFFER = Value * 1e9
    end)

    ShopBox:AddDropdown(
        "Start when",
        {"All items stocked", "Any item stocked"},
        "Any item stocked",
        function(Value)
            START_WHEN = (Value == "Any item stocked") and "any" or "all"
        end
    )

    local TeamOptions = {}

    for TeamNumber = 1, 13 do
        TeamOptions[TeamNumber] = tostring(TeamNumber)
    end

    ShopBox:AddDropdown("Farming team", TeamOptions, tostring(FarmingTeam), function(Value)
        FarmingTeam = tonumber(Value) or FarmingTeam
        debugPrint("ShopFarm", "[Shop Farm] Farming team set to:", FarmingTeam)
    end)

    ShopBox:AddDropdown("Luck team", TeamOptions, tostring(RestoreTeam), function(Value)
        RestoreTeam = tonumber(Value) or RestoreTeam
        debugPrint("ShopFarm", "[Shop Farm] Restore team set to:", RestoreTeam)
    end)

    ShopToggle = addToggle(ShopBox, "Auto farm shop currency", false, function(Value)
        ShopEnabled = Value

        debugPrint(
            "ShopFarm",
            "[Shop Farm] " .. (Value and "enabled, watching the shop..." or "disabled")
        )

        if Value then
            startWatcher()
        else
            ShopSession += 1
            stopFarming()
        end
    end)

    ShopBox:AddButton("Print shop status", function()
        runDebugButton(printShopStatus)
    end)

    onCleanup(function()
        ShopEnabled = false
        ShopSession += 1
        stopFarming()
    end)
end

